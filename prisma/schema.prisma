// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Product table stores all available products
model Product {
  id                 Int                @id @default(autoincrement()) // Primary key
  productName        String                               // Name of the product
  productDescription String?            @db.VarChar(100)  // Optional product description
  orders             OrderProductMap[]                   // Relation to orders
}

/// Order table stores customer orders
model Order {
  id               Int                @id @default(autoincrement()) // Primary key
  orderDescription String             @db.VarChar(100)       // Description of the order
  createdAt        DateTime  @default(now())           // Order creation timestamp
  products         OrderProductMap[]                   // Relation to products
}

/// Many-to-Many relationships between Orders and Products
model OrderProductMap {
  id        Int     @id @default(autoincrement())       // Primary key
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade) // Link to Order
  orderId   Int                                         // Foreign key to Order
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade) // Link to Product
  productId Int                                         // Foreign key to Product
}
